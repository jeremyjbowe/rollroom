# Connect a PRIVATE Vercel Blob store; Vercel adds this automatically.
BLOB_READ_WRITE_TOKEN=
# Username is always admin. No public registration or additional accounts.
# Generate a scrypt hash with pnpm admin:password (password via stdin).
ADMIN_PASSWORD_HASH=
# Generate at least 32 random bytes; do not reuse the password.
ADMIN_SESSION_SECRET=
